# Copy this file to .env (which is git-ignored) and fill in the real key.
# Never commit .env or paste the key into issues, screenshots, or the README.

# Shared key for the class endpoints (ask the team for the real value)
COURSE_API_KEY=your-class-api-key-here

# Class server (ports 9001-9005 are added automatically)
CLASS_HOST=http://dobolyi.com

# Optional per-service overrides (defaults shown)
# LLM_BASE_URL=http://dobolyi.com:9001/v1
# LLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
# TEXT_EMBED_BASE_URL=http://dobolyi.com:9002
# TEXT_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
# VISUAL_EMBED_BASE_URL=http://dobolyi.com:9003/v1
# VISUAL_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
# RERANK_BASE_URL=http://dobolyi.com:9004
# RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
# PARSER_BASE_URL=http://dobolyi.com:9005/v1
# PARSER_MODEL=dots.mocr

# Retrieval / generation settings
# USE_RERANKER=true
# EVIDENCE_K=4            # pages/slides sent to the LLM per answer
# CANDIDATE_K=12          # fused candidates sent to the reranker
# SUPPORT_CHECK=true      # extra LLM call that checks sources support the answer
# OCR_MODE=auto           # auto = OCR pages without a text layer; off = never
# LLM_DISABLE_THINKING=true

# Where the library and indexes are stored (git-ignored)
# DATA_DIR=data

# Path to LibreOffice if it is not found automatically
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
